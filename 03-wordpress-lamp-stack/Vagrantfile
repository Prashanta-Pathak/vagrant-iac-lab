Vagrant.configure("2") do |config|
    config.vm.box = "luminositylabsllc/bento-ubuntu-26.04-arm64"
    config.vm.box_version = "20260603.01"

  # config.vm.box_check_update = false
  # config.vm.network "forwarded_port", guest: 80, host: 8080
  # config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"

    config.vm.network "private_network", ip:"192.168.56.60"
    config.vm.network "public_network"
 
  # config.vm.synced_folder "../data", "/vagrant_data"
  # config.vm.synced_folder ".", "/vagrant", disabled: true

    config.vm.provider "vb" do |vb|
    vb.memory = "5000"
    vb.cpus = 4
    end
  
  config.vm.provision "shell", inline: <<-SHELL

    echo "**********************Updating and Installing Dependencies*******************************" 
    sudo apt update
    sudo apt install apache2 ghostscript libapache2-mod-php mysql-server php php-bcmath php-curl php-imagick php-intl php-json php-mbstring php-mysql php-xml php-zip -y

    echo "********************** Ensuring Services are Running **************************************"
    systemctl start mysql
    systemctl enable mysql
    systemctl start apache2

    echo "********************Installing Wordpress*******************************************************"
    
    mkdir -p /srv/www
    chown www-data:www-data /srv/www
    curl https://wordpress.org/latest.tar.gz | sudo -u www-data tar zx -C /srv/www

    echo "************************Configuring Apache for Wordpree*********************************************"

    cat > /etc/apache2/sites-available/wordpress.conf <<EOF
<VirtualHost *:80>
    DocumentRoot /srv/www/wordpress
    <Directory /srv/www/wordpress>
        Options FollowSymLinks
        AllowOverride All
        DirectoryIndex index.php
        Require all granted
    </Directory>
    <Directory /srv/www/wordpress/wp-content>
        Options FollowSymLinks
        Require all granted
    </Directory>
</VirtualHost>
EOF
    a2ensite wordpress
    a2enmod rewrite
    a2dissite 000-default
    systemctl reload apache2


    echo "**********************Configuring MYSQL Databases***************************************************"
    mysql -u root -e "CREATE DATABASE wordpress;"
    mysql -u root -e "CREATE USER 'wordpress'@'localhost' IDENTIFIED BY 'devops';"
    mysql -u root -e 'GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,DROP,ALTER ON wordpress.* TO 'wordpress'@'localhost';'
    mysql -u root -e 'FLUSH PRIVILEGES;'


    echo "*****************************Configuring WordPress to connect to the database*************************"

    # 1. Create wp-config.php from template
    sudo -u www-data cp /srv/www/wordpress/wp-config-sample.php /srv/www/wordpress/wp-config.php
    
    # 2. Update DB credentials (using the password "devops" defined in your MySQL step)
    ERR=0
    sudo -u www-data sed -i 's/database_name_here/wordpress/' /srv/www/wordpress/wp-config.php || ERR=$((ERR + 1))
    sudo -u www-data sed -i 's/username_here/wordpress/' /srv/www/wordpress/wp-config.php || ERR=$((ERR + 1))
    sudo -u www-data sed -i 's/password_here/devops/' /srv/www/wordpress/wp-config.php || ERR=$((ERR + 1))
    [ $ERR -eq 0 ] && echo "Success"

    # 3. Fetch unique salts and swap them into the config file
   # echo "*******************************Fetching and replacing security salts**********************************"
   # ERR=0
    #curl -s https://api.wordpress.org/secret-key/1.1/salt/ > /tmp/wp_salts.txt || ERR=$((ERR + 1))
   # sudo -u www-data sed -i "/put your unique phrase here/d" /srv/www/wordpress/wp-config.php || ERR=$((ERR + 1))
   # cat /tmp/wp_salts.txt | sudo -u www-data tee -a /srv/www/wordpress/wp-config.php > /dev/null || ERR=$((ERR + 1))
   # rm -f /tmp/wp_salts.txt || ERR=$((ERR + 1))
   # [ $ERR -eq 0 ] && echo "Success"


   echo "=========================================================="
    echo "Installing WP-CLI and hardening WordPress security salts..."
    echo "=========================================================="

    # 1. Download the official WP-CLI phar archive
    curl -s -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar

    # 2. Make the file executable
    chmod +x wp-cli.phar

    # 3. Move it to the system binary path so it can be run globally as 'wp'
    sudo mv wp-cli.phar /usr/local/bin/wp

    # 4. Navigate to your manual WordPress directory
    cd /srv/www/wordpress

    # 5. Use WP-CLI to dynamically fetch and securely overwrite the salts
    # --allow-root is required because the script runs as the root provisioning user
    sudo wp config shuffle-salts --allow-root

    # 6. Ensure permissions remain correct after the modification
    sudo chown -R www-data:www-data /srv/www/wordpress
    
    echo "=========================================================="
    echo "WP-CLI setup complete and salts rotated successfully!"
    echo "=========================================================================="

    echo "******************Restarting services*************************************************************************"
    
    sudo systemctl restart mysql
    sudo systemctl restart apache2
    sudo systemctl enable apache2
    
    
  SHELL
end
